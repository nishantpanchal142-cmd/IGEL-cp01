<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#fff9fb">
<title>For Pari — A Little Birthday Surprise</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap');
:root{--ink:#51465d;--muted:#897e91;--pink:#f5b8cc;--pink2:#ffe3ec;--lav:#dcd2f7;--blue:#d7eafa;--mint:#d9f0e6;--cream:#fffaf5;--white:#fff;--line:#f1e7ee;--shadow:0 16px 45px #78627a12}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:'DM Sans',sans-serif;background:radial-gradient(circle at 5% 5%,#fff0f5 0,transparent 25rem),radial-gradient(circle at 95% 18%,#f0ecff 0,transparent 28rem),#fffdfc;overflow-x:hidden}
button,a{font:inherit}button{cursor:pointer}.wrap{width:min(1120px,92%);margin:auto}.topbar{position:sticky;top:0;z-index:20;background:#ffffffd9;backdrop-filter:blur(14px);border-bottom:1px solid #f4eaf0}.nav{height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-weight:800;letter-spacing:-.05em;font-size:1.3rem;color:#9b7bb7}.brand span{color:#e79db7}.navlinks{display:flex;gap:7px;align-items:center}.navlinks a{font-size:.88rem;text-decoration:none;color:var(--muted);padding:10px 13px;border-radius:99px}.navlinks a:hover{background:#fff0f5;color:#a56d8d}.menu{display:none;border:0;background:#fff0f5;padding:9px 12px;border-radius:12px;color:#9b6f8b}
.hero{padding:74px 0 55px;position:relative}.hero-grid{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:45px}.eyebrow{display:inline-flex;gap:8px;align-items:center;padding:8px 13px;background:#fff0f5;border:1px solid #f8dce7;border-radius:99px;color:#b27692;font-size:.8rem;font-weight:700}.hero h1{font-family:'Playfair Display',serif;font-size:clamp(3rem,7vw,5.7rem);line-height:1.02;letter-spacing:-.055em;margin:20px 0 16px;color:#5d506a}.hero h1 em{font-style:normal;color:#df91b0}.hero p{font-size:1.08rem;line-height:1.8;color:var(--muted);max-width:540px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.btn{border:0;border-radius:14px;padding:13px 19px;font-weight:800;transition:.2s;box-shadow:0 7px 18px #d99bb51c}.btn:hover{transform:translateY(-2px)}.primary{background:#eaa8c1;color:white}.soft{background:#f2edff;color:#8a75a9}.hero-art{min-height:370px;border-radius:35px;background:linear-gradient(145deg,#ffe8ef,#f1eaff 58%,#e6f3ff);display:grid;place-items:center;position:relative;overflow:hidden;box-shadow:var(--shadow);border:1px solid white}.hero-art:before,.hero-art:after{content:"";position:absolute;border-radius:50%;background:#ffffff80}.hero-art:before{width:220px;height:220px;top:-75px;right:-55px}.hero-art:after{width:160px;height:160px;bottom:-70px;left:-35px}.friend-illustration{font-size:8rem;filter:drop-shadow(0 12px 8px #9b789222);z-index:1}.art-note{position:absolute;z-index:2;background:#ffffffdf;padding:12px 17px;border-radius:14px;box-shadow:var(--shadow);font-family:'Playfair Display',serif;font-size:1.1rem}.note1{top:35px;left:25px;transform:rotate(-7deg)}.note2{bottom:32px;right:22px;transform:rotate(5deg)}
.spark{position:absolute;color:#fff;font-size:1.5rem;animation:float 4s ease-in-out infinite}.s1{top:24%;right:17%}.s2{bottom:25%;left:15%;animation-delay:1s}@keyframes float{50%{transform:translateY(-13px) rotate(12deg)}}
.section{padding:55px 0}.section-head{text-align:center;margin:0 auto 28px;max-width:650px}.kicker{text-transform:uppercase;letter-spacing:.16em;color:#c18aa6;font-size:.72rem;font-weight:800}.section h2{font-family:'Playfair Display',serif;font-size:clamp(2rem,4vw,3rem);margin:8px 0;color:#5e5269}.section-head p{color:var(--muted);line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:17px;max-width:720px;margin:auto}.card{background:#fff;border:1px solid var(--line);border-radius:23px;padding:23px;box-shadow:var(--shadow)}.card h3{margin:9px 0 7px;font-size:1.08rem}.card p{color:var(--muted);line-height:1.65;font-size:.94rem;margin:0}.emoji{font-size:2rem}.tint-pink{background:linear-gradient(145deg,#fff,#fff3f7)}.tint-lav{background:linear-gradient(145deg,#fff,#f5f1ff)}.tint-blue{background:linear-gradient(145deg,#fff,#f0f8ff)}.tint-mint{background:linear-gradient(145deg,#fff,#f0faf5)}
.center{text-align:center}.wishbox{max-width:650px;margin:auto;text-align:center;background:linear-gradient(135deg,#fff4f7,#f4f0ff);border:1px solid white;border-radius:28px;padding:35px;box-shadow:var(--shadow)}.wish{font-family:'Playfair Display',serif;font-size:1.35rem;min-height:70px;display:grid;place-items:center;color:#78658c;margin:12px 0}
.memory-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.polaroid{background:white;padding:12px 12px 18px;border-radius:9px;box-shadow:0 10px 25px #78627a15;transform:rotate(var(--r));border:1px solid #f4edf1}.photo-placeholder{height:175px;border-radius:5px;display:grid;place-items:center;font-size:3rem;background:linear-gradient(135deg,#ffeaf0,#eee9ff)}.polaroid p{text-align:center;font-family:'Playfair Display',serif;margin:13px 0 0;color:#76677e}.hint{font-size:.8rem;color:#a095a5;margin-top:14px}
.quiz{max-width:650px;margin:auto}.quiz-options{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.quiz-options button{border:1px solid #eadfed;background:#fff;border-radius:13px;padding:13px;color:var(--ink);font-weight:700}.quiz-options button:hover{background:#fff1f6;border-color:#efb9cc}.feedback{min-height:28px;margin-top:15px;color:#ad7796;font-weight:700}
.letter{max-width:760px;margin:auto;background:#fffdf7;border:1px solid #f3e8d7;border-radius:10px;padding:34px 38px;box-shadow:var(--shadow);position:relative}.letter:before{content:"";position:absolute;inset:12px;border:1px dashed #eadccf;border-radius:7px;pointer-events:none}.letter p{position:relative;line-height:1.9;color:#786d7a}.letter .sign{font-family:'Playfair Display',serif;font-size:1.4rem;color:#c17e9c}
.cake{font-size:6rem;display:block;margin:4px auto 12px;filter:drop-shadow(0 10px 8px #dca3b733)}.cakebox{max-width:600px;margin:auto;text-align:center;background:#fff;border:1px solid var(--line);border-radius:25px;padding:28px;box-shadow:var(--shadow)}
.footer{padding:35px 0;text-align:center;color:#a496a9;font-size:.88rem;border-top:1px solid var(--line);margin-top:35px}.footer strong{color:#c28ca8}
.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);background:#62556d;color:#fff;padding:12px 18px;border-radius:99px;opacity:0;transition:.3s;z-index:50;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}
.confetti{position:fixed;top:-15px;width:9px;height:13px;z-index:60;animation:fall 2.7s linear forwards;pointer-events:none}@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.1}}

@media(max-width:760px){.navlinks{display:none;position:absolute;top:69px;left:4%;right:4%;background:white;border:1px solid var(--line);padding:12px;border-radius:17px;box-shadow:var(--shadow);flex-wrap:wrap}.navlinks.open{display:flex}.navlinks a{width:calc(50% - 5px)}.menu{display:block}.hero{padding:45px 0 25px}.hero-grid{grid-template-columns:1fr;gap:24px}.hero-art{min-height:270px}.friend-illustration{font-size:6rem}.grid{grid-template-columns:1fr 1fr}.memory-grid{grid-template-columns:1fr 1fr}.photo-placeholder{height:135px}.section{padding:40px 0}.letter{padding:25px}.quiz-options{grid-template-columns:1fr 1fr}}
@media(max-width:430px){.grid{grid-template-columns:1fr}.memory-grid{gap:12px}.polaroid{padding:8px 8px 14px}.photo-placeholder{height:115px}.hero h1{font-size:3.2rem}.actions .btn{width:100%}}
.balloon{position:fixed;bottom:-60px;z-index:99;pointer-events:none;animation:floatUp linear forwards}@keyframes floatUp{to{transform:translateY(-115vh) rotate(12deg);opacity:.9}}
.musicbtn{position:fixed;right:14px;bottom:14px;z-index:60;border:1px solid #eadfed;background:#fff;color:#ad7796;font-weight:700;border-radius:999px;padding:10px 16px;box-shadow:0 8px 20px #78627a22;cursor:pointer}.musicbtn.on{background:#fff1f6;border-color:#efb9cc}
.ow-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:720px;margin:auto}.ow{border:1px solid var(--line);background:#fff;border-radius:18px;padding:18px 16px;text-align:center;box-shadow:var(--shadow);cursor:pointer;font:inherit;color:var(--ink);display:flex;flex-direction:column;gap:10px}.ow-title{font-weight:700}.ow-msg{display:none;font-size:.92rem;line-height:1.5;color:#76677e}.ow.opened{background:#fff1f6;border-color:#efb9cc}.ow.opened .ow-msg{display:block}
.awesome-card{max-width:620px;margin:auto;background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px 26px;box-shadow:var(--shadow)}.awesome-card ul{list-style:none;margin:0;padding:0}.awesome-card li{padding:11px 0;border-bottom:1px dashed #eadfed;line-height:1.5}.awesome-card li:last-child{border-bottom:0}
@media(max-width:560px){.ow-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="topbar"><div class="wrap nav"><a class="brand" href="#home">little <span>moments</span> ✿</a><button class="menu" id="menuBtn" aria-label="Open menu">☰</button><nav class="navlinks" id="navlinks"><a href="#wishes">Wishes</a><a href="#fun">Bestie quiz</a><a href="#openwhen">Open when</a><a href="#letter">Letter</a><a href="#cake">Birthday cake</a></nav></div></header>
<main>
<section class="hero" id="home"><div class="wrap hero-grid"><div><span class="eyebrow">✿ A tiny birthday universe, made for you</span><h1>Happy Birthday,<br><em>Pari!</em> ♡</h1><p>For all the laughs, silly talks, random adventures and memories that make friendship so special. Today is all about celebrating you!</p><div class="actions"><a class="btn primary" href="#wishes" style="text-decoration:none">Explore your surprise ✨</a><a class="btn soft" href="#letter" style="text-decoration:none">A little note 💌</a></div></div><div class="hero-art"><span class="art-note note1">bestie energy ✿</span><span class="friend-illustration">👭🏻</span><span class="art-note note2">friends make life brighter</span><span class="spark s1">✦</span><span class="spark s2">♡</span></div></div></section>
<section class="section" id="wishes"><div class="wrap"><div class="section-head"><div class="kicker">A pocket full of happy thoughts</div><h2>A Jar Full of Wishes 🫙</h2><p>Pick a little note whenever you need a smile. There are plenty more where these came from.</p></div><div class="wishbox"><div class="emoji">🫙💗</div><div class="wish" id="wishText">May your year be filled with tiny joys and big reasons to smile.</div><button class="btn primary" id="wishBtn">Open a wish ✨</button></div></div></section>
<section class="section" id="fun"><div class="wrap"><div class="section-head"><div class="kicker">A very serious friendship test</div><h2>How well do you know your bestie? 😂</h2><p>One tiny quiz. Absolutely no pressure. (Okay, maybe a little.)</p></div><div class="card quiz center"><div class="emoji">🧠✨</div><h3 id="quizQuestion">Who is more likely to laugh at the worst possible time?</h3><div class="quiz-options" id="quizOptions"><button data-answer="You">Me 😇</button><button data-answer="Pari">Pari 😂</button></div><div class="feedback" id="quizFeedback"></div><button class="btn soft" id="nextQuiz">Next question ↗</button></div></div></section>
<section class="section" id="letter"><div class="wrap"><div class="section-head"><div class="kicker">A note from the heart</div><h2>A Little Letter 💌</h2></div><article class="letter"><p>Dear Pari,</p><p>Happy Birthday! 🥹 I hope this year brings you countless reasons to smile, new adventures to look forward to and people who remind you how wonderful you are.</p><p>Thank you for being part of so many laughs, random conversations and unforgettable little moments. Keep being your funny, caring, wonderfully-you self. And yes, please continue being a little dramatic — it would be too quiet otherwise. 😂</p><p>Whatever this year brings, I hope you always find courage for the hard days and extra happiness on the good ones. You deserve all the lovely things life has to offer.</p><p>Stay happy, stay awesome, and never stop being you. ♡</p><p class="sign">Your friend, Nishant ✿</p></article></div></section>
<section class="section" id="openwhen"><div class="wrap"><div class="section-head"><div class="kicker">Little notes for little moments</div><h2>Open When... 💌</h2><p>Tap a note whenever you need it.</p></div><div class="ow-grid">
<button class="ow"><span class="ow-title">Open when you're sad 🌧️</span><span class="ow-msg">It's okay to have a bad day. Take a deep breath, drink some water, and remember you've survived every bad day so far. I'm just a text away. 💗</span></button>
<button class="ow"><span class="ow-title">Open when you're bored 🥱</span><span class="ow-msg">Text me. Seriously. We'll find something silly to talk about in 2 minutes. 😂</span></button>
<button class="ow"><span class="ow-title">Open when you miss me 🫶</span><span class="ow-msg">Same. Now send me a random meme and I'll know exactly what you mean. 😌</span></button>
<button class="ow"><span class="ow-title">Open when you doubt yourself ✨</span><span class="ow-msg">You're stronger, kinder and cooler than you think. Say that out loud once. Yes, right now. 💪</span></button>
<button class="ow"><span class="ow-title">Open when you need a laugh 😂</span><span class="ow-msg">Remember that moment you laughed at the worst possible time? Yeah. That one. You're welcome. 🤭</span></button>
<button class="ow"><span class="ow-title">Open when you can't sleep 🌙</span><span class="ow-msg">Put the phone down (after reading this), close your eyes, and think of something happy. Tomorrow will be better. 😴</span></button>
</div></div></section>
<section class="section" id="awesome"><div class="wrap"><div class="section-head"><div class="kicker">The official list</div><h2>Why You're Awesome 🌟</h2></div><div class="awesome-card"><ul>
<li>You laugh at the funniest times, and somehow it makes everything funnier. 😂</li>
<li>You care a lot, even when you pretend you don't. 💗</li>
<li>Your drama makes ordinary days way more entertaining. 🎭</li>
<li>You turn simple plans into little adventures. 🌷</li>
<li>You're always up for silly talks and random jokes. 🫶</li>
<li>You're just really, really good to have around. ✨</li>
</ul></div></div></section>
<section class="section" id="cake"><div class="wrap"><div class="section-head"><div class="kicker">Make a birthday wish</div><h2>One More Candle to Blow 🎂</h2><p>Close your eyes, make a wish and tap the button!</p></div><div class="cakebox"><span class="cake" id="cakeEmoji">🎂</span><button class="btn primary" id="cakeBtn">Make a wish 🌟</button><p class="hint" id="cakeMsg">Your wish is between you and the universe. 🤫</p></div></div></section>
<section class="section"><div class="wrap"><div class="grid"><div class="card tint-lav center"><div class="emoji">🌈</div><h3>A reminder for you</h3><p>You make ordinary days brighter just by being yourself. Keep shining, Pari!</p></div><div class="card tint-blue center"><div class="emoji">🎁</div><h3>One last thing</h3><p>May your next trip around the sun be your happiest one yet.</p><button class="btn soft" id="surpriseBtn">Open a tiny surprise</button></div></div></div></section>
</main>
<footer class="footer"><div class="wrap">Made with <strong>♡</strong> and lots of friendship for Pari · <span id="year"></span></div></footer>
<button class="musicbtn" id="musicBtn" aria-label="Toggle music">🎵 Play music</button>
<div class="toast" id="toast" role="status"></div>
<script>
const wishes=["May your days be full of sunshine, laughter and lovely surprises. 🌷","May every dream you are quietly working on find its way to you. ✨","May you always have a reason to laugh until your cheeks hurt. 😂","May this year bring new places, new stories and beautiful memories. 🌈","Never forget how strong, kind and wonderfully unique you are. 💗","May your snacks never run out and your phone battery never die. 🍰","Here's to more random talks, silly jokes and unforgettable days. 🫶"];
let wi=-1;const wishText=document.getElementById('wishText');document.getElementById('wishBtn').onclick=()=>{wi=(wi+1)%wishes.length;wishText.textContent=wishes[wi];};
const questions=[
["Who is more likely to laugh at the worst possible time?",["Me 😇","Pari 😂"],["Haan haan, tum toh innocent ho. Sure. 😏","Correct. Pari ki hasi kabhi bhi shuru ho jaati hai. 😂"]],
["Who takes longer to get ready?",["Me ⏰","Pari 🎀"],["Wow, brave answer. 👀","Pari: 'Bas 5 minute.' (1 ghanta later) 🎀"]],
["Who would survive longer without checking their phone?",["Me 📵","Pari 📱"],["Impossible. Phone dono ka best friend hai. 😂","Pari ke bina phone? Not happening. 📱"]],
["Who is the bigger drama queen/king?",["Me 🎭","Pari 🍿"],["Self-awareness unlocked! 🎭","Drama ka Oscar Pari ko jaata hai. 🏆"]],
["Who eats more when food arrives?",["Me 🍕","Pari 🍰"],["Share karna mat bhoolna! 🍕","Pari ka plate, Pari ke rules. 🍰"]],
["Who replies slower on chat?",["Me 💬","Pari 🐌"],["Seen karke chhod dena bhi ek art hai. 😌","Pari: 'Sorry, abhi dekha!' (3 din baad) 🐌"]],
["Who is the better advice giver?",["Me 🧠","Pari 💗"],["Overconfident, but okay. 😎","Sach mein, Pari ki advice hamesha kaam aati hai. 💗"]],
["Who will be friends forever?",["Me 🫶","Pari 🫶"],["Obviously. Forever! ✨","Obviously. Forever! ✨"]]
];
let qi=0;function renderQuiz(){document.getElementById('quizQuestion').textContent=questions[qi][0];document.getElementById('quizOptions').innerHTML=questions[qi][1].map((x,i)=>`<button data-answer="${i}">${x}</button>`).join('');document.getElementById('quizFeedback').textContent='';document.querySelectorAll('#quizOptions button').forEach(b=>b.onclick=()=>{document.getElementById('quizFeedback').textContent=questions[qi][2][+b.dataset.answer];if(qi===questions.length-1)confetti();});}
document.getElementById('nextQuiz').onclick=()=>{qi=(qi+1)%questions.length;renderQuiz();};renderQuiz();
function balloons(){const em=['🎈','🎈','🎈','🎉','💗','✨'];for(let i=0;i<14;i++){let b=document.createElement('span');b.className='balloon';b.textContent=em[i%em.length];b.style.left=(Math.random()*90+2)+'vw';b.style.fontSize=(2+Math.random()*1.8)+'rem';b.style.animationDuration=(3.5+Math.random()*2.5)+'s';b.style.animationDelay=Math.random()*.8+'s';document.body.appendChild(b);setTimeout(()=>b.remove(),7500);}}
function confetti(){const colors=['#f4aeca','#cbbcf1','#b9d9ef','#c4e9d8','#f8d89c'];for(let i=0;i<110;i++){let e=document.createElement('i');e.className='confetti';e.style.left=Math.random()*100+'vw';e.style.background=colors[i%colors.length];e.style.animationDelay=Math.random()*.7+'s';e.style.transform=`rotate(${Math.random()*360}deg)`;document.body.appendChild(e);setTimeout(()=>e.remove(),3500);}}
document.getElementById('cakeBtn').onclick=()=>{document.getElementById('cakeEmoji').textContent='🧁';document.getElementById('cakeMsg').textContent='Wish made! May something wonderful come true. 💫';confetti();balloons();};
document.getElementById('surpriseBtn').onclick=()=>{toast('Surprise! You are appreciated more than you know. 💗');confetti();};
function toast(t){let el=document.getElementById('toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2600);}
document.getElementById('menuBtn').onclick=()=>document.getElementById('navlinks').classList.toggle('open');document.querySelectorAll('.navlinks a').forEach(a=>a.onclick=()=>document.getElementById('navlinks').classList.remove('open'));document.getElementById('year').textContent=new Date().getFullYear();

// Background music: Happy Birthday tune, played with Web Audio (no audio file needed)
(function(){const btn=document.getElementById('musicBtn');let ctx=null,timer=null,on=false;
const N={G4:392,A4:440,B4:493.88,C5:523.25,D5:587.33,E5:659.25,F5:698.46,G5:783.99};
const tune=[['G4',.75],['G4',.25],['A4',1],['G4',1],['C5',1],['B4',2],['G4',.75],['G4',.25],['A4',1],['G4',1],['D5',1],['C5',2],['G4',.75],['G4',.25],['G5',1],['E5',1],['C5',1],['B4',1],['A4',1],['F5',.75],['F5',.25],['E5',1],['C5',1],['D5',1],['C5',2]];
const beat=.5;function play(){let t=ctx.currentTime+.05;tune.forEach(([n,b])=>{const o=ctx.createOscillator(),g=ctx.createGain(),d=b*beat;o.type='triangle';o.frequency.value=N[n];g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.16,t+.03);g.gain.exponentialRampToValueAtTime(.001,t+d*.95);o.connect(g);g.connect(ctx.destination);o.start(t);o.stop(t+d);t+=d;});timer=setTimeout(()=>{if(on)play();},(t-ctx.currentTime+1.2)*1000);}
btn.onclick=()=>{if(!on){ctx=new (window.AudioContext||window.webkitAudioContext)();on=true;play();btn.textContent='🎵 Music: on';btn.classList.add('on');}else{on=false;clearTimeout(timer);ctx.close();btn.textContent='🎵 Play music';btn.classList.remove('on');}};})();
document.querySelectorAll('.ow').forEach(b=>b.onclick=()=>b.classList.toggle('opened'));
</script>
</body></html>